{
  "name": "dsh-node",
  "version": "0.1.0",
  "description": "DSH plugin: outbound WebSocket adapter that lets a Coordinator call this machine's already-registered DSH Remote capabilities.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run declarations && tsdown",
    "declarations": "tsc -p tsconfig.build.json",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "external": [],
      "immediately": false
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "react": ">=18.2.0"
  },
  "dependencies": {
    "schemastery": "3.18.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-api-gateway": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-typert-registry": "0.1.2-alpha.2",
    "@types/node": "^22.15.0",
    "@types/react": "18.3.0",
    "@types/react-dom": "18.3.0",
    "@types/ws": "^8.5.13",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.15.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "private": true
}
