# `pnpm run` performs a "deps status" check that re-invokes `pnpm install`, which
# is useless here (the committed lockfile is the trust anchor) and actively
# harmful in two ways observed on this machine:
#
#   1. the nested install spawns a child process over a piped channel, which the
#      DSH sandbox denies, so `pnpm run <script>` fails before the script starts;
#   2. when it does run, it decides `node_modules` must be purged and aborts with
#      ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY in a non-interactive shell.
#
# Turning the check off keeps `pnpm test` / `pnpm typecheck` / `pnpm build`
# runnable without a TTY and without wider sandbox permissions.
verify-deps-before-run=false

# Belt and braces for (2): if some other command path decides to purge, do it
# without prompting rather than aborting.
confirmModulesPurge=false

# NOTE (2026-09-20, after DSH Desktop updated): neither key above was honoured by
# the pnpm that DSH now bundles at `resources/app/node_modules/pnpm` — `pnpm run`
# still ran the deps-status check and aborted on the purge prompt. The reliable
# form on this machine is the CLI flag:
#
#   pnpm --config.verify-deps-before-run=false typecheck
#   pnpm --config.verify-deps-before-run=false test
#   pnpm --config.verify-deps-before-run=false build
#
# Or invoke the tools directly, which needs no pnpm at all:
#
#   node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit
#   node node_modules/vitest/vitest.mjs run
